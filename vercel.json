{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "installCommand": "cd ../.. && npm install --include=optional && npm install --no-save @rollup/rollup-linux-x64-gnu",
      "buildCommand": "cd ../.. && npm -w apps/web run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "api": {
      "root": "server",
      "framework": "express",
      "entrypoint": "src/index.ts",
      "installCommand": "cd .. && npm install --include=optional",
      "functions": {
        "src/index.ts": {
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/socket.io", "destination": { "service": "api" } },
    { "source": "/socket.io/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
