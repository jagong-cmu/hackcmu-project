MONGODB_URI=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=
# Optional. Keys the hashed public player id used only in the local-dev guest
# opt-out (AUTH_REQUIRED=0 below). Unset = derived from the LiveKit secret +
# Mongo URI. Any long random string; keep it the same on every server instance.
PLAYER_ID_SECRET=
PUBLIC_URL=
VITE_SOCKET_URL=
VITE_LIVEKIT_WS_URL=

# Supabase Auth (Google sign-in). REQUIRED: there is no guest play. Without
# these the web app shows "Accounts aren't configured" on every play route and
# the server refuses every play path (socket hello, score posts, LiveKit
# tokens, room snapshots, training scores) — it never falls back to trusting
# the client. Project URL + anon / publishable key only — never the
# service_role / secret key. The web build reads these (repo-root .env or
# .env.local). The server reads the same two values (or SUPABASE_URL /
# SUPABASE_ANON_KEY) to verify players' access tokens, so set them on the API
# service too.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-side overrides (optional; fall back to the VITE_ values above).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Google OAuth *web* client id (public, not a secret) — the same value as the
# Supabase Google provider's client id (SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID).
# Turns on the Google Identity Services button, so Google's sign-in names this
# site instead of <project>.supabase.co. Unset = Supabase redirect flow.
# The OAuth client needs this site's origin under "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=

# LOCAL DEVELOPMENT ONLY: set to 0 to play without accounts (old guest mode,
# e.g. to play both seats yourself in two tabs). One line in the repo-root
# .env.local covers both sides. Leave it unset everywhere else — "1" or empty
# changes nothing, accounts are always required.
#   - web: honoured only under `vite dev` (import.meta.env.DEV); a production
#     build ignores it.
#   - server: honoured only when NODE_ENV != production and not on Vercel /
#     Render (VERCEL / RENDER set). The server also accepts AUTH_REQUIRED=0.
# Production cannot turn accounts off through env.
VITE_AUTH_REQUIRED=

# PostHog Cloud free project (https://us.posthog.com/signup — no card).
# Same project token on the client (baked in at `npm run build`) and server.
# US cloud host: https://us.i.posthog.com   EU: https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Lane A: serve the /songs/_test click track instead of the catalog, so clock
# work is not blocked on song files. Unset once real instrumentals land.
USE_TEST_SONG=
