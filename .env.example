MONGODB_URI=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WS_URL=
# Optional. Keys the guest-mode public player id (an HMAC of the secret
# clientId). Unset = derived from the LiveKit secret + Mongo URI. Any long
# random string; keep it the same on every server instance.
PLAYER_ID_SECRET=
PUBLIC_URL=
VITE_SOCKET_URL=
VITE_LIVEKIT_WS_URL=

# Supabase Auth (Google sign-in). Required to play when set; unset = guest mode.
# Project URL + anon / publishable key only — never the service_role / secret key.
# The web build reads these (repo-root .env or .env.local). The server reads the
# same two values (or SUPABASE_URL / SUPABASE_ANON_KEY) to verify players' access
# tokens against Supabase, so set them on the API service too.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Accounts stay off (guest play) until this is 1. Set it on both the web build
# and the API service once the Google provider works in Supabase.
VITE_AUTH_REQUIRED=
# Server-side overrides (optional; fall back to the VITE_ values above).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# PostHog Cloud free project (https://us.posthog.com/signup — no card).
# Same project token on the client (baked in at `npm run build`) and server.
# US cloud host: https://us.i.posthog.com   EU: https://eu.i.posthog.com
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Lane A: serve the /songs/_test click track instead of the catalog, so clock
# work is not blocked on song files. Unset once real instrumentals land.
USE_TEST_SONG=
