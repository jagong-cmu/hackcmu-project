{
  "name": "karaoke-arena",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm -w server run dev",
    "dev:web": "npm -w apps/web run dev",
    "build": "npm -w apps/web run build",
    "start": "npm -w server run start",
    "typecheck": "tsc -p apps/web --noEmit && tsc -p server --noEmit",
    "songs": "node apps/web/scripts/build-demo-tracks.mjs",
    "tunnel": "cloudflared tunnel --url http://localhost:8080"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^4.22.2"
  }
}
